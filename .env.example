# Port the panel listens on (on the host when using Docker).
# Prefix it with 127.0.0.1: to listen on this machine only, e.g. PORT=127.0.0.1:3000.
PORT=3000

# Long random string used to encrypt secrets at rest. Generate one with:
#   openssl rand -hex 32
# If you leave it empty, a key is generated and stored next to the database.
APP_SECRET=

# Where the SQLite database lives when running from source (Docker uses a volume).
# DATA_DIR=./data

# auto | true | false
COOKIE_SECURE=auto

# Only used when building the image yourself: npm registry or mirror to download packages from.
# NPM_REGISTRY=https://registry.npmjs.org/
